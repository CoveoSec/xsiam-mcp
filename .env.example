# Copy to .env and fill in — or set these directly in your MCP client's env block.
# Obtain from: XSIAM console → Settings → Configurations → Integrations → API Keys

XSIAM_API_KEY=your-api-key-secret
XSIAM_API_KEY_ID=42
XSIAM_FQDN=myco.xdr.us.paloaltonetworks.com

# Optional
# XSIAM_BASE_URL=https://api-myco.xdr.us.paloaltonetworks.com   # overrides XSIAM_FQDN
# XSIAM_AUTH_TYPE=standard          # standard (default) | advanced
# XSIAM_TOOLSETS=Incidents,XQL query,Response Action   # scope down the toolset
# XSIAM_TIMEOUT=60
# XSIAM_VERIFY_TLS=true
